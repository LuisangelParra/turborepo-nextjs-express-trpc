{
  "name": "test",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "drizzle-kit generate:pg --config=packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit push:pg --config=packages/db/drizzle.config.ts",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.21.4",
    "drizzle-orm": "^0.32.2",
    "pg": "^8.16.3"
  }
}
